# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nafas

# Long random string used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Your 4-digit admin PIN (full access)
ADMIN_PIN=1234

# Optional: server port (defaults to 3000)
# PORT=3000

# ── SOLID FLEX module (all optional; module works without these) ──
# Login rate limiting: max PIN attempts per window (default 5)
# SF_LOGIN_MAX_ATTEMPTS=5
# Rate limit window in minutes (default 10)
# SF_LOGIN_WINDOW_MINUTES=10
